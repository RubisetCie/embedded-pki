#
# OpenSSL example configuration file.
# See doc/man5/config.pod for more info.
#
# This is mostly being used for generation of certificate requests,
# but may be used for auto loading of providers

# Note that you can include other files from the main configuration
# file using the .include directive.
#.include filename

# This definition stops the following lines choking if HOME isn't defined
HOME							= .

# Use this in order to automatically load providers
openssl_conf					= openssl_init

# Comment out the next line to ignore configuration errors
config_diagnostics				= 1

# Defaults properties
dir								= .
crl_dir							= $dir/crl
crlnumber						= $dir/crlnumber
certs							= $dir/certs
serial							= $dir/serial
database						= $dir/index.txt
new_certs_dir					= $dir/newcerts
unique_subject					= yes			# Set to 'no' to allow creation of several certs with same subject

crl								= $dir/crl.crl
certificate						= $dir/cacert.cer
private_key						= $dir/private/cakey.key
RANDFILE						= $dir/private/ca.rand

# Extra object identifiers info
# oid_file						= $ENV::HOME/.oid
oid_section						= new_oids

# Add subjectKeyIdentifier and authorityKeyIdentifier extensions by default
extensions						= default_skid_akid


[openssl_init]
providers						= provider_sect


# List of providers to load
[provider_sect]
default							= default_sect

[default_sect]
#identity						= my_module
#module							= module_so
#activate						= yes

[default_skid_akid]
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer


[new_oids]
#testoid1						= 1.2.3.4
#testoid2						= ${testoid1}.5.6


[ca]
default_ca						= ca_all

[ca_all]
name_opt						= ca_default
cert_opt						= ca_default

crl_extensions					= crl_ext

default_days					= 365			# How long to certify for
default_crl_days				= 30			# How long before next CRL
default_md						= default		# Default message digest
preserve						= no			# Keep passed DN ordering

x509_extensions					= v3_cert_ca	# The extensions to add to the cert

policy							= policy_match


[req]
default_bits					= 2048
distinguished_name				= req_distinguished_name
attributes						= req_attributes

# Passwords for private keys if not present they will be prompted for
#input_password					= secret
#output_password				= secret

# This sets a mask for permitted string types
string_mask						= default


# For the CA policy, match the main fields
[policy_match]
countryName						= match
stateOrProvinceName				= match
organizationName				= match
organizationalUnitName			= optional
commonName						= supplied
emailAddress					= optional

# For the 'anything' policy, list all acceptable object types.
[policy_anything]
countryName						= optional
stateOrProvinceName				= optional
localityName					= optional
organizationName				= optional
organizationalUnitName			= optional
commonName						= supplied
emailAddress					= optional


[req_distinguished_name]
countryName						= Country Name (2 letter code)
countryName_default				= FR
countryName_min					= 2
countryName_max					= 2

stateOrProvinceName				= State or Province Name (full name)
stateOrProvinceName_default		= Some-State

localityName					= Locality Name (eg, city)

0.organizationName				= Organization Name (eg, company)
0.organizationName_default		= Rubis et Compagnie

# We can do this but it is not needed normally
#1.organizationName				= Second Organization Name (eg, company)
#1.organizationName_default		= World Wide Web Pty Ltd

organizationalUnitName			= Organizational Unit Name (eg, section)
#organizationalUnitName_default	=

commonName						= Common Name (e.g. server FQDN or YOUR name)
commonName_max					= 64

emailAddress					= Email Address
emailAddress_max				= 64

[req_attributes]
challengePassword				= A challenge password
challengePassword_min			= 4
challengePassword_max			= 20
unstructuredName				= An optional company name


[crl_ext]
authorityKeyIdentifier			= keyid:always


[v3_req_ca]
basicConstraints				= CA:true
keyUsage						= cRLSign,keyCertSign

# Extensions for a typical CA
[v3_cert_ca]
basicConstraints				= critical,CA:true
keyUsage						= cRLSign,keyCertSign
nsComment						= Embedded PKI Root CA
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer

# Include email address in subject alt name (PKIX recommendation)
subjectAltName					= email:copy

[v3_req_user]

basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature,keyEncipherment

[v3_cert_user]
basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature,keyEncipherment
nsComment						= Embedded PKI User certificate
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer

# Include email address in subject alt name (PKIX recommendation)
subjectAltName					= email:copy

# CRL distribution points and authority info access (for OCSP)
#crlDistributionPoints			= URI:http://example.com/myca.crl,URI:(...)
#authorityInfoAccess			= OCSP;URI:http://ocsp.example.com/,caIssuers;URI:http://myca.example.com/ca.cer


[v3_req_signer]
basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature
nsCertType						= client,email

[v3_cert_signer]
basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature
nsCertType						= client,email
nsComment						= Embedded PKI Signer certificate
subjectAltName					= email:copy
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer


[v3_req_sslclient]
basicConstraints				= CA:false
keyUsage						= digitalSignature
extendedKeyUsage				= clientAuth
nsCertType						= client

[v3_cert_sslclient]
basicConstraints				= CA:false
keyUsage						= digitalSignature
extendedKeyUsage				= clientAuth
nsCertType						= client
nsComment						= Embedded PKI SSL Client certificate
subjectAltName					= email:copy
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer


[v3_req_sslserver]
basicConstraints				= CA:false
keyUsage						= digitalSignature,keyEncipherment
extendedKeyUsage				= serverAuth
nsCertType						= server

[v3_cert_sslserver]
basicConstraints				= CA:false
keyUsage						= digitalSignature,keyEncipherment
extendedKeyUsage				= serverAuth
nsCertType						= server
nsComment						= Embedded PKI SSL Server certificate
subjectAltName					= email:copy
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer


[v3_req_ocsp]
basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature
extendedKeyUsage				= 1.3.6.1.5.5.7.3.9

[v3_cert_ocsp]
basicConstraints				= CA:false
keyUsage						= nonRepudiation,digitalSignature
extendedKeyUsage				= 1.3.6.1.5.5.7.3.9
nsComment						= Embedded PKI OCSP certificate
subjectAltName					= email:copy
subjectKeyIdentifier			= hash
authorityKeyIdentifier			= keyid,issuer
